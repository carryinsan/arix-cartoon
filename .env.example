# Add these under Vercel → Project → Settings → Environment Variables.
# Keep secrets on the server. NEVER add Gemini keys to app.js or index.html.
GEMINI_KEY=
GEMINI_KEY2=
GEMINI_KEY3=

# Current model defaults. Override only when your Google AI Studio project has access.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
